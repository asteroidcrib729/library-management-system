# Local FastAPI configuration. Copy to .env only if your launcher loads it.
LMS_ENVIRONMENT=local
LMS_ALLOWED_ORIGINS=http://localhost:3000
LMS_API_HOST=127.0.0.1
LMS_API_PORT=8000

# The API opens its pool in lifespan and checks schema version 3 when this is set.
# Never place a production or hosted Supabase URL in the local environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
LMS_DB_POOL_MAX=5
LMS_DB_POOL_MAX_WAITING=10
LMS_DB_ACQUIRE_TIMEOUT=2
LMS_DB_LOCK_TIMEOUT_MS=2000
LMS_DB_STATEMENT_TIMEOUT_MS=5000
LMS_DB_IDLE_TIMEOUT_MS=10000

# Opaque browser sessions and process-local admission controls.
LMS_SESSION_COOKIE=lms_session
LMS_CSRF_COOKIE=lms_csrf
LMS_SESSION_IDLE_MINUTES=30
LMS_SESSION_ABSOLUTE_HOURS=12
LMS_LOGIN_RATE_LIMIT=5
LMS_MUTATION_RATE_LIMIT=120
LMS_RATE_WINDOW_SECONDS=60
LMS_MAX_BODY_BYTES=65536

# Optional absolute client-tool paths for Plan 15 logical backup/recovery commands.
# LMS_PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# LMS_PG_RESTORE=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
